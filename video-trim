#!/usr/bin/env bash
# Launcher: runs the project via uv (installs deps on first use). Works on macOS and Linux.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command -v uv >/dev/null || { echo "uv missing: https://docs.astral.sh/uv/ (brew install uv)"; exit 1; }
exec uv run --quiet --project "$here" video-trim "$@"
